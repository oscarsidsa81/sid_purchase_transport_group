<odoo>
    <record id="view_purchase_transport_packing_line_tree" model="ir.ui.view">
        <field name="name">purchase.transport.packing.line.tree</field>
        <field name="model">purchase.transport.packing.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="group_id"/>
                <field name="purchase_order_id"/>
                <field name="description"/>
                <field name="package_count"/>
                <field name="length_cm"/>
                <field name="width_cm"/>
                <field name="height_cm"/>
                <field name="weight_kg"/>
                <field name="volume_m3"/>
            </tree>
        </field>
    </record>

    <record id="view_purchase_transport_packing_type_tree" model="ir.ui.view">
        <field name="name">purchase.transport.packing.type.tree</field>
        <field name="model">purchase.transport.packing.type</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="max_weight_kg"/>
                <field name="max_volume_m3"/>
                <field name="ref_length_cm"/>
                <field name="ref_width_cm"/>
                <field name="ref_height_cm"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_purchase_transport_packing_line" model="ir.actions.act_window">
        <field name="name">Packing list transporte</field>
        <field name="res_model">purchase.transport.packing.line</field>
        <field name="view_mode">tree,form</field>
        <field name="groups_id" eval="[(4, ref('sid_purchase_transport_group.group_purchase_transport_user'))]"/>
    </record>

    <record id="action_purchase_transport_packing_type" model="ir.actions.act_window">
        <field name="name">Capacidades transporte</field>
        <field name="res_model">purchase.transport.packing.type</field>
        <field name="view_mode">tree</field>
        <field name="groups_id" eval="[(4, ref('sid_purchase_transport_group.group_purchase_transport_manager'))]"/>
    </record>
</odoo>
